# Database
DATABASE_URL=postgresql+asyncpg://rainbow:changeme@db:5432/rainbow
POSTGRES_PASSWORD=changeme

# Session security (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-hex-string

# Public site name (used in the wordmark, titles and landing page)
SITE_NAME=Vantage

# New players and teams start at this rating
STARTING_ELO=500
STARTING_RD=350
STARTING_VOLATILITY=0.06

# Show a Provisional badge above this rating deviation
PROVISIONAL_RD=200

# Reject reported scores above this value per side
MAX_SCORE_PER_SIDE=20

# Set true when the app is served over HTTPS (Secure session cookie)
COOKIE_SECURE=false

# Absolute origin used for links in Discord notifications (optional)
PUBLIC_BASE_URL=http://localhost:8090

# Discord OAuth (create app at https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8090/auth/callback

# Optional: post match results to a Discord channel webhook
DISCORD_WEBHOOK_URL=

# Testing only: enables GET /auth/dev and logs in as this fake Discord id.
# Leave empty in production; when set, anyone who can reach the site can use it.
DEV_LOGIN_DISCORD_ID=
DEV_LOGIN_USERNAME=DevAdmin
DEV_LOGIN_ADMIN=false

# Player reports wait for the opponent; admin reports apply immediately.
REQUIRE_MATCH_CONFIRMATION=true

# Close active seasons automatically when their end date passes.
AUTO_CLOSE_SEASONS=false
SEASON_CLOSE_HOUR=4
SEASON_LENGTH_DAYS=90
